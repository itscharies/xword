VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only needed to run the backfill/fetch scripts locally (npm run
# migrate:puzzles / npm run fetch) — never used by the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 (via `npm run dev:mock`) to run against an in-memory mock backend
# instead of the real Supabase project above — see src/lib/mockSupabase.ts.
VITE_MOCK_BACKEND=
